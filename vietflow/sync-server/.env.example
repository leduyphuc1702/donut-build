# Copy to .env and fill in. Never commit .env.

# The server's domain, pointed at its IP with an A record. Without a domain,
# <IP with dashes>.sslip.io works too, e.g. 203-0-113-7.sslip.io
SYNC_DOMAIN=sync.example.com

# Shared secret every Donut app enters as the sync token: openssl rand -hex 32
SYNC_TOKEN=CHANGE_ME

# Keys of the local S3 store (any long random strings): openssl rand -hex 20
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Encrypts every stored file and routes transfers through donut-sync:
# echo "k1:$(openssl rand -base64 32)"
SYNC_AT_REST_KEY=CHANGE_ME
