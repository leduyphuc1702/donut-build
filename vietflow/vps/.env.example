# Copy to .env and fill in. Never commit .env.
#
# Every secret below is `openssl rand -hex 32` unless noted. Generate them on
# the server and keep the file mode 600.

# Hostnames. Without a domain, <IP with dashes>.sslip.io works:
# 45-76-164-228.sslip.io, control.45-76-164-228.sslip.io, ...
CONTROL_DOMAIN=control.example.com
SYNC_DOMAIN=sync.example.com

# Password for /auth/link and /admin on the control plane.
CONTROL_TOKEN=CHANGE_ME

# Key a released build uses to sign in on first launch (DONUT_SELF_HOST_KEY).
# Leave empty to disable auto sign-in.
AUTO_LOGIN_KEY=

# JWT signing key for the control plane (not the same as CONTROL_TOKEN).
JWT_SECRET=CHANGE_ME

ACCOUNT_ID=selfhosted-owner
ACCOUNT_EMAIL=owner@selfhosted.local
ACCOUNT_PLAN=enterprise
TEAM_ID=local-team
TEAM_NAME=Vietflow

# Shared sync token every Donut app enters under Account -> Self-hosted.
SYNC_TOKEN=CHANGE_ME

# Keys of the local S3 store (any long random strings, 40 hex chars each).
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Encrypts every stored file and routes transfers through donut-sync:
# echo "k1:$(openssl rand -base64 32)"
SYNC_AT_REST_KEY=CHANGE_ME

# Audience for the sync token the control plane mints.
SYNC_SERVER_URL=https://sync.example.com
