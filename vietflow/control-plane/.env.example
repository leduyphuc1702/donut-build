# Copy to .env and fill in. Never commit .env.

# Tên miền trỏ về VPS (bản ghi A). Caddy tự xin HTTPS.
CONTROL_DOMAIN=control.example.com

# Mật khẩu để lấy mã đăng nhập một lần. Tối thiểu 16 ký tự:
# openssl rand -hex 32
CONTROL_TOKEN=CHANGE_ME

# Khóa để bản Donut đã phát hành tự đăng nhập ở lần mở đầu tiên, không cần
# mã dùng một lần. Để trống thì dùng CONTROL_TOKEN. Đặt riêng nếu muốn thu hồi
# quyền tự đăng nhập mà không đổi mật khẩu lấy mã:
# openssl rand -hex 32
AUTO_LOGIN_KEY=

# Khóa ký JWT. Đổi thành chuỗi ngẫu nhiên riêng, đừng dùng lại CONTROL_TOKEN:
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Tài khoản chủ sở hữu của nhóm. Nhân viên được thêm ở https://<CONTROL_DOMAIN>/admin
# (đăng nhập bằng CONTROL_TOKEN), mỗi người có tài khoản và mã đăng nhập riêng.
ACCOUNT_ID=selfhosted-owner
ACCOUNT_EMAIL=owner@selfhosted.local
ACCOUNT_PLAN=enterprise

# Nhóm của tài khoản này. Mọi bản cài dùng chung TEAM_ID sẽ thấy cùng một
# nhóm và một nhật ký hoạt động (DATA_DIR/team.json; thành viên ở
# DATA_DIR/members.json). Đổi TEAM_ID sau khi đã có dữ liệu sẽ tách nhật ký cũ
# ra khỏi giao diện.
TEAM_ID=local-team
TEAM_NAME=Vietflow

# Nơi lưu nhật ký hoạt động và danh sách thành viên. Docker đặt /data và mount volume riêng.
# DATA_DIR=data

# Tùy chọn: địa chỉ donut-sync, dùng làm audience cho sync token.
# SYNC_SERVER_URL=https://sync.example.com
